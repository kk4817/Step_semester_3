import java.util.*;

abstract class Appliance {
    double hours;

    Appliance(double hours) {
        this.hours = hours;
    }

    abstract double power();

    boolean supportsSaver() {
        return false;
    }

    double units() {
        return power() * hours / 1000;
    }

    double cost() {
        return units() * 8;
    }
}

class Fridge extends Appliance {
    Fridge(double hours) {
        super(hours);
    }

    double power() {
        return 150;
    }
}

class AC extends Appliance {
    boolean saver;

    AC(double hours, boolean saver) {
        super(hours);
        this.saver = saver;
    }

    double power() {
        return 1500;
    }

    boolean supportsSaver() {
        return true;
    }

    double units() {
        double u = super.units();
        return saver ? u * 0.75 : u;
    }
}

class TV extends Appliance {
    TV(double hours) {
        super(hours);
    }

    double power() {
        return 100;
    }
}

class Washer extends Appliance {
    boolean saver;

    Washer(double hours, boolean saver) {
        super(hours);
        this.saver = saver;
    }

    double power() {
        return 500;
    }

    boolean supportsSaver() {
        return true;
    }

    double units() {
        double u = super.units();
        return saver ? u * 0.75 : u;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            double hours = sc.nextDouble();

            boolean saver = false;

            if (sc.hasNext()) {
                if (sc.nextLine().trim().equals("SAVER")) {
                    saver = true;
                }
            }

            Appliance appliance;

            if (type.equals("FRIDGE")) {
                if (saver) {
                    System.out.println("FRIDGE: saver mode not supported");
                    continue;
                }
                appliance = new Fridge(hours);
            } else if (type.equals("AC")) {
                appliance = new AC(hours, saver);
            } else if (type.equals("TV")) {
                if (saver) {
                    System.out.println("TV: saver mode not supported");
                    continue;
                }
                appliance = new TV(hours);
            } else {
                appliance = new Washer(hours, saver);
            }

            double units = appliance.units();
            double cost = appliance.cost();

            total += cost;

            System.out.printf(
                "%s: Units=%.2f Cost=%.2f%n",
                type, units, cost
            );
        }

        System.out.printf("Total Cost: %.2f%n", total);
        sc.close();
    }
}
