import java.util.Arrays;

public class LibraryBookShelf {

    public static void shelf(int[] books) {
        // Start from the second book (index 1) since the first book is already placed
        for (int i = 1; i < books.length; i++) {
            int newBook = books[i]; // Keep the new book in a variable
            int j = i - 1;

            // Move every bigger book on its left one place to the right
            while (j >= 0 && books[j] > newBook) {
                books[j + 1] = books[j];
                j--;
            }

            // Put the new book into the gap
            books[j + 1] = newBook;

            // Print the shelf after placing the current book
            System.out.println("After placing " + newBook + ": " + Arrays.toString(books));
        }
    }

    public static void main(String[] args) {
        // Sample Input
        System.out.println("--- Sample Test ---");
        int[] sampleBooks = {30, 10, 40, 20};
        shelf(sampleBooks);

        // Custom Input
        System.out.println("\n--- Custom Test ---");
        int[] customBooks = {55, 25, 80, 15, 45};
        shelf(customBooks);
    }
}
