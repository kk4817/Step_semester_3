public class BookCopyFinder {

    // Custom Node class as required
    static class Node {
        String data;
        Node next;

        Node(String data) {
            this.data = data;
            this.next = null;
        }
    }

    public static String find(Node head, String id) {
        int position = 1;
        int firstPosition = -1;
        int copies = 0;

        Node current = head;

        // Walk through the chain once
        while (current != null) {
            if (current.data.equals(id)) {
                if (firstPosition == -1) {
                    firstPosition = position; // Record only the first match
                }
                copies++;
            }
            current = current.next;
            position++;
        }

        if (copies == 0) {
            return id + " not found";
        }

        return id + " first at position " + firstPosition + ", copies: " + copies;
    }

    // Example usage matching the test cases
    public static void main(String[] args) {
        // Building chain: B12 -> B07 -> B30 -> B07 -> B45 -> B07
        Node head = new Node("B12");
        head.next = new Node("B07");
        head.next.next = new Node("B30");
        head.next.next.next = new Node("B07");
        head.next.next.next.next = new Node("B45");
        head.next.next.next.next.next = new Node("B07");

        System.out.println(find(head, "B07")); // Output: B07 first at position 2, copies: 3
        System.out.println(find(head, "B99")); // Output: B99 not found
    }
}
