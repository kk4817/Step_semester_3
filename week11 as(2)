import java.util.Arrays;

public class PrizeTable {

    public static int prizeTable(int[] marks) {
        int swaps = 0;
        int n = marks.length;

        for (int i = 0; i < n - 1; i++) {
            int maxIndex = i;

            // Find the index of the highest mark in the unsorted portion
            for (int j = i + 1; j < n; j++) {
                if (marks[j] > marks[maxIndex]) {
                    maxIndex = j;
                }
            }

            // Swap only if the highest mark is not already at position i
            if (maxIndex != i) {
                int temp = marks[i];
                marks[i] = marks[maxIndex];
                marks[maxIndex] = temp;
                swaps++;
            }
        }

        return swaps;
    }

    public static void main(String[] args) {
        // Sample Input 1
        int[] marks1 = {45, 90, 60, 75};
        int swaps1 = prizeTable(marks1);
        System.out.println(Arrays.toString(marks1) + "  swaps = " + swaps1);

        // Sample Input 2
        int[] marks2 = {80, 70, 60};
        int swaps2 = prizeTable(marks2);
        System.out.println(Arrays.toString(marks2) + "  swaps = " + swaps2);

        // Custom Input
        int[] marks3 = {50, 85, 95, 70, 60};
        int swaps3 = prizeTable(marks3);
        System.out.println(Arrays.toString(marks3) + "  swaps = " + swaps3);
    }
}
