import java.util.Arrays;

public class DiceThrowTally {

    public static int[] diceSort(int[] rolls) {
        // Step 1: Create a count array of size 7 (indices 0 to 6)
        int[] count = new int[7];

        // Step 2: Count the occurrences of each dice roll (1 to 6)
        for (int roll : rolls) {
            if (roll >= 1 && roll <= 6) {
                count[roll]++;
            }
        }

        // Step 3: Print the counts in the required format
        System.out.print("Counts: ");
        for (int v = 1; v <= 6; v++) {
            System.out.print(v + ":" + count[v] + (v < 6 ? "  " : ""));
        }
        System.out.println();

        // Step 4: Build and return the sorted array
        int[] sortedRolls = new int[rolls.length];
        int index = 0;

        for (int v = 1; v <= 6; v++) {
            for (int c = 0; c < count[v]; c++) {
                sortedRolls[index++] = v;
            }
        }

        return sortedRolls;
    }

    public static void main(String[] args) {
        // Test 1: Sample Input from the problem
        int[] sampleRolls = {4, 1, 6, 4, 2, 1, 4};
        System.out.println("Sample Input: " + Arrays.toString(sampleRolls));
        int[] sortedSample = diceSort(sampleRolls);
        System.out.println("Sorted: " + Arrays.toString(sortedSample));

        System.out.println(); // Blank line between test cases

        // Test 2: Custom Input (as requested by the assignment instructions)
        int[] customRolls = {6, 5, 5, 3, 2, 6, 1, 3};
        System.out.println("Custom Input: " + Arrays.toString(customRolls));
        int[] sortedCustom = diceSort(customRolls);
        System.out.println("Sorted: " + Arrays.toString(sortedCustom));
    }
}
