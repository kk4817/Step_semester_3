class HallTicket {

    String studentName;
    int seatNumber;

    // Constructor
    HallTicket(String studentName, int seatNumber) {
        this.studentName = studentName;
        this.seatNumber = seatNumber;
    }
}

public class M4 {

    public static void main(String[] args) {

        // First object
        HallTicket priya =
            new HallTicket("Priya", 0);

        // Second variable pointing to SAME object
        HallTicket copy = priya;

        // Change through second reference
        copy.seatNumber = 45;

        // Both references see the same change
        System.out.println(
            "Priya's seatNumber (via first variable): "
            + priya.seatNumber
        );

        // == checks whether both references point
        // to the same object
        System.out.println(
            "copy == priya: " + (copy == priya)
        );

        // Third object
        HallTicket separate =
            new HallTicket("Priya", 45);

        // Same values, but different object
        System.out.println(
            "separate == priya: " + (separate == priya)
        );
    }
}
