public class BusRoute {

    // Custom Node class with data and next fields
    static class Node {
        String data;
        Node next;

        Node(String data) {
            this.data = data;
            this.next = null;
        }
    }

    // Builds the linked list from the array of stop names in order
    public static Node build(String[] stops) {
        if (stops == null || stops.length == 0) {
            return null;
        }

        Node head = new Node(stops[0]);
        Node current = head;

        for (int i = 1; i < stops.length; i++) {
            current.next = new Node(stops[i]);
            current = current.next;
        }

        return head;
    }

    // Prints the route chain, total count, first stop, and last stop
    public static void printRoute(Node head) {
        if (head == null) {
            return;
        }

        int count = 0;
        String first = head.data;
        String last = head.data;
        Node current = head;

        while (current != null) {
            System.out.print(current.data + " -> ");
            last = current.data; // Updates until the final non-null node
            count++;
            current = current.next;
        }
        System.out.println("null");
        System.out.println("Stops: " + count + ", First: " + first + ", Last: " + last);
    }

    // Main method to test the provided samples
    public static void main(String[] args) {
        // Sample 1
        String[] sample1 = {"Tambaram", "Guindy", "TNagar", "Central"};
        Node route1 = build(sample1);
        printRoute(route1);

        System.out.println();

        // Sample 2
        String[] sample2 = {"Potheri"};
        Node route2 = build(sample2);
        printRoute(route2);
    }
}
