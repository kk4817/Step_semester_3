class Node {
    String data;
    Node next;

    Node(String data) {
        this.data = data;
        this.next = null;
    }
}

public class BookingChain {

    public static Node removeFirst(Node head, String booking) {
        // Case 1: The list is empty
        if (head == null) {
            System.out.println(booking + " not found");
            return null;
        }

        // Case 2: The booking to cancel is at the head
        if (head.data.equals(booking)) {
            return head.next;
        }

        // Case 3: Search for the node right before the target booking
        Node current = head;
        while (current.next != null && !current.next.data.equals(booking)) {
            current = current.next;
        }

        // If found, bypass the target node; otherwise, print not found message
        if (current.next != null) {
            current.next = current.next.next;
        } else {
            System.out.println(booking + " not found");
        }

        return head;
    }

    // Helper method to print the chain matching the expected output format
    public static void printChain(Node head) {
        Node current = head;
        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }
        System.out.println("null");
    }

    public static void main(String[] args) {
        // Sample 1: 104 -> 101 -> 107 -> 101, cancel = 101
        Node head1 = new Node("104");
        head1.next = new Node("101");
        head1.next.next = new Node("107");
        head1.next.next.next = new Node("101");
        
        head1 = removeFirst(head1, "101");
        printChain(head1); // Output: 104 -> 107 -> 101 -> null

        // Sample 3: 104 -> 101, cancel = 200
        Node head3 = new Node("104");
        head3.next = new Node("101");
        
        head3 = removeFirst(head3, "200"); // Prints: 200 not found
        printChain(head3);                 // Output: 104 -> 101 -> null
    }
}
